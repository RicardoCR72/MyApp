    "@capacitor/cli": "8.5.2",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.0.0",
    "eslint": "^9.16.0",
    "jsdom": "^26.0.0",
    "typescript": "~6.0.0",
