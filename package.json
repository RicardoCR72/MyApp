{
  "name": "geosport-radar-app",
  "version": "1.0.0",
  "description": "Aplicación de Geolocalización, Mapas Leaflet y Radar de Sedes Deportivas",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 8100",
    "serve": "ng serve --host 0.0.0.0 --port 8100",
    "build": "ng build",
    "build:pwa": "ng build --configuration production",
    "serve:pwa": "python -m http.server 8100 --directory www",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.0.1",
